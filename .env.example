# FUD Portal — Production Environment Configuration
# Copy this file to .env and fill in ALL values before deploying.
# NEVER commit .env to version control.
#
# Generate secure secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ────────────────────────────────────────────────────────────────────────────
# APPLICATION
# ────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ────────────────────────────────────────────────────────────────────────────
# DATABASE
# ────────────────────────────────────────────────────────────────────────────
# Absolute path recommended in production. Outside web root.
DB_PATH=/var/data/fud-portal/fud_portal.db

# ────────────────────────────────────────────────────────────────────────────
# JWT — SECURITY CRITICAL
# Generate unique 48+ character secrets for each key.
# Using the same secret for both ACCESS and REFRESH tokens is a vulnerability.
# ────────────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_48_CHAR_RANDOM_HEX_ACCESS_TOKEN_SECRET
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_48_CHAR_RANDOM_HEX_REFRESH_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────────────────────────
# BCRYPT
# 12 rounds is recommended for production (bcrypt default is 10).
# Increasing to 14 adds ~4x login time — ensure UX is acceptable.
# ────────────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ────────────────────────────────────────────────────────────────────────────
# DEFAULT SUPERADMIN (created on first run only)
# CHANGE THESE from defaults before deploying!
# ────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@your-school.edu.ng
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_FULL_NAME=Super Administrator
ADMIN_STAFF_ID=ADM/001/2024

# ────────────────────────────────────────────────────────────────────────────
# CORS — Frontend URL
# Comma-separate multiple origins: https://app.example.com,https://www.example.com
# ────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com

# ────────────────────────────────────────────────────────────────────────────
# FILE UPLOADS
# ────────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=/var/www/fud-portal/uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_DOC_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ────────────────────────────────────────────────────────────────────────────
# RATE LIMITING
# Times are in milliseconds. Window = 15 minutes (900,000 ms).
# ────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20

# ────────────────────────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────────────────────────
LOG_DIR=/var/log/fud-portal
LOG_LEVEL=warn

# ────────────────────────────────────────────────────────────────────────────
# EMAIL — SMTP Configuration
# Option A: Gmail (requires App Password — not your Gmail login password)
#   1. Enable 2FA on your Google account
#   2. Go to: myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#
# Option B: Custom SMTP (SendGrid, Mailgun, AWS SES, etc.)
#   Set EMAIL_HOST, EMAIL_PORT, EMAIL_SECURE, EMAIL_USER, EMAIL_PASS
#
# Option C: Leave blank for Ethereal (dev/testing only — NOT for production)
# ────────────────────────────────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_FROM=noreply@your-school.edu.ng
EMAIL_FROM_NAME=FUD Portal
SUPPORT_EMAIL=support@your-school.edu.ng
EMAIL_WORKER_INTERVAL_MS=30000

# ────────────────────────────────────────────────────────────────────────────
# BACKUPS (used by scripts/backup.sh)
# ────────────────────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/fud-portal
BACKUP_RETENTION_DAYS=30

# Optional: AWS S3 backup upload
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BACKUP_BUCKET=my-school-backups

# Optional: rclone remote backup
# RCLONE_REMOTE=myremote
